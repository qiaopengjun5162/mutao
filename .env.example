# 运行环境：设为 production 时，启动会强制校验 JWT_SECRET 必须存在且 >= 32 字节，
# 否则拒绝启动；其他值（development/test/留空）为开发模式，缺失 JWT_SECRET 仅告警并使用内置默认密钥。
APP_ENV=development
DATABASE_URL=postgres://mutao:mutao@db:5432/mutao
# 生产环境必填，至少 32 字节（APP_ENV=production 时强制）。请替换为高强度随机值。
JWT_SECRET=change-this-in-production-to-a-32-byte-or-longer-random-secret
ETH_RPC_URL=
ETH_CONTRACT_ADDRESS=
